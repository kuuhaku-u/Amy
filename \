# ---------------- TOOLS ----------------
def write_expense(data):
    sheet.append_row([
        datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        data.get("amount"),
        data.get("currency"),
        data.get("category"),
        data.get("product"),
        data.get("brand"),
        data.get("description"),
        data.get("confidence")
    ])
    return "Expense saved ✔"


def read_expenses(limit=10):
    return sheet.get_all_records()[-limit:]


# ---------------- TOOL DEFINITIONS FOR LLM ----------------
TOOLS = """
You have 3 tools:

1. write_expense:
Use when user talks about spending money.

Auto identify category by brand name or commom knowledge 
Returns structured JSON:
{
  "tool": "write_expense",
  "data": {
    "amount": number,
    "currency": "INR",
    "category": string,
    "product": string,
    "brand": string,
    "description": string,
    "confidence": number
  }
}

2. read_expenses:
Use when user asks:
- show expenses
- history
- what did I spend

Returns:
{
  "tool": "read_expenses"
}

3. insights:
Use when user asks:
- how much did I spend
- analysis
- summary

Returns:
{
  "tool": "insights"
}

Return ONLY JSON.
"""


# ---------------- INSIGHTS ----------------
def analyze():
    data = read_expenses(50)

    response = chat(
        model="qwen2.5:7b",
        messages=[{
            "role": "user",
            "content": f"""
You are a financial analyst.

Analyze this data:
{data}

Give:
- category breakdown
- spending habits
- warnings
- suggestions
"""
        }]
    )

    return response["message"]["content"]


# ---------------- INPUT MODEL ----------------
class Input(BaseModel):
    text: str


# ---------------- MAIN STREAM ENDPOINT ----------------
@app.post("/stream")
async def stream(input: Input):

    async def run():

        yield "Thinking...\n"

        # STEP 1: ASK LLM TO CHOOSE TOOL
        decision = chat(
            model="qwen2.5:7b",
            format="json",
            messages=[{
                "role": "user",
                "content": TOOLS + "\n\nUser input:\n" + input.text
            }]
        )
        print(decision, "TOOLS")
        content = decision["message"]["content"]

        match = re.search(r"\{.*\}", content, re.DOTALL)
        if not match:
            yield f"Error: {content}"
            return

        action = json.loads(match.group(0))

        tool = action.get("tool")

        # ---------------- TOOL: WRITE ----------------
        if tool == "write_expense":
            data = action["data"]
            print(data)
            write_expense(data)
            yield f"\n📝 Expense saved:\n{json.dumps(data, indent=2)}\n"

        # ---------------- TOOL: READ ----------------
        elif tool == "read_expenses":
            data = read_expenses(10)

            yield "\n📊 Last Expenses:\n"
            yield json.dumps(data, indent=2)

        # ---------------- TOOL: INSIGHTS ----------------
        elif tool == "insights":
            result = analyze()
            yield "\n🧠 Insights:\n"
            yield result

        else:
            yield "\n❌ Unknown tool decision"

        yield "\nDONE"

    return StreamingResponse(run(), media_type="text/plain")  
